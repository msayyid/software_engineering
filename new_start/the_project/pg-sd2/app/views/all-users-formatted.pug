extends layout 
block content 
    h1 All Users Formatted Page 
    table(border=1)
        tr 
            th user_id 
            th user_name 
            th email 
            th location 

        for user in results 
            tr 
                td #{user.user_id}
                td 
                    a(href=`./single-user/${user.user_id}`) #{user.first_name} #{user.last_name}
                td #{user.email} 
                td #{user.location}