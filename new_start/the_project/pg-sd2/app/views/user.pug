extends layout 
block content 
    .main_content  
        h1 this is a single user page for #{user.user_id} - #{user.first_name}  #{user.last_name}
        h2 and this is a line for the user email address - #{user.email}
        br
        h3 here is the whole data
        table(border=1)
            tr 
                th Field 
                th Value 
        
            each value, key in user 
                tr 
                    td #{key}
                    td #{value} 
