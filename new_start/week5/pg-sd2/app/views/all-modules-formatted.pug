extends layout 
block content 
    .main-content 
    h1 All Modules Formatted  
    br
    table(border=1)
        tr  
            th 
                b Module Code 
            th  
                b Module Name 

        for m in modules 
            tr 
                td #{m.code}
                td 
                    a(href=`./single-module/${m.code}`) #{m.name}