extends layout 
block content 
    h1 Student Page For: #{student.name}
    p The ID for the student is: #{student.id} 
    p Note for this student: #{student.note} 
    h2 Programme: #{student.programme.name}
    h2 Modules 
    table(border=1)
        tr 
            th Module Code 
            th Module Name
        for module in student.modules 
            tr 
                td= module.code 
                td
                    a(href=`/single-module/${module.code}`) #{module.name}

        
    h2 Add a note about this student 
    form(action=`/add-note`, method="POST")
        input(type="hidden" name="id" value=student.id)
        textarea(name="note", rows=6 cols=50)
        div
        input(type="submit" value="Submit") 

    form(action="/allocate-programme", method="POST")
        input(type="hidden" name="id" value=student.id)
        select(name="programme")
            for programme in programmes 
                if programme.id == student.programme.id
                    option(value=programme.id selected="selected") #{programme.name}
                else
                    option(value=programme.id) #{programme.name}
        <div>
        input(type="submit", value="Submit")

    div 
        p 
            a(href="/welcome") Welcome page
                    



